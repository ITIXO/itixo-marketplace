{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT.replaceAll(String.fromCharCode(92), '/'), 'scripts/dirigent-runtime.js')).invoke(['codex','session-start'])\"",
            "statusMessage": "Loading Dirigent..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT.replaceAll(String.fromCharCode(92), '/'), 'scripts/dirigent-runtime.js')).invoke(['codex','user-prompt-submit'])\"",
            "statusMessage": "Updating Dirigent..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/runtime-model.js\"",
            "statusMessage": "Checking agent model..."
          },
          {
            "type": "command",
            "command": "node -e \"require(require('node:path').join(process.env.PLUGIN_ROOT.replaceAll(String.fromCharCode(92), '/'), 'scripts/dirigent-runtime.js')).invoke(['codex','subagent-start'])\"",
            "statusMessage": "Loading Dirigent for agent..."
          }
        ]
      }
    ]
  }
}
