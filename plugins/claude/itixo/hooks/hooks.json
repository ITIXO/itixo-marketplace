{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Loading Dirigent...",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT.replaceAll(String.fromCharCode(92), '/'), 'scripts/dirigent-runtime.js')).invoke(['claude','session-start'])\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Updating Dirigent...",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT.replaceAll(String.fromCharCode(92), '/'), 'scripts/dirigent-runtime.js')).invoke(['claude','user-prompt-submit'])\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Loading Dirigent for agent...",
            "command": "node -e \"require(require('node:path').join(process.env.CLAUDE_PLUGIN_ROOT.replaceAll(String.fromCharCode(92), '/'), 'scripts/dirigent-runtime.js')).invoke(['claude','subagent-start'])\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Checking investigation guidance...",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/investigation-nudge.js\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task|Edit|Write|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Recording tool usage...",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/log-tool.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Summarizing delegation...",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/delegation-summary.js\""
          }
        ]
      }
    ]
  }
}
